generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model MenuCategory {
  id        String     @id @default(cuid())
  name      String     @unique
  name1     String?
  name2     String?
  name3     String?
  name4     String?
  group     MenuCategoryGroup @default(OTHER)
  sortOrder Int        @default(0)
  items     MenuItem[]
}

model MenuItem {
  id         String       @id @default(cuid())
  name       String
  name1      String?
  name2      String?
  name3      String?
  name4      String?
  imageUrl   String?
  dietaryInfo String?
  price      Float
  currency   String       @default("BAM")
  sortOrder  Int          @default(0)
  isActive   Boolean      @default(true)
  isAvailable Boolean      @default(true)
  categoryId String
  category   MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId])
}

model Order {
  id          String      @id @default(cuid())
  tableId     String
  clientRequestId String? @unique
  status      OrderStatus @default(UNCLAIMED)
  createdAt   DateTime    @default(now())
  claimedAt   DateTime?
  completedAt DateTime?
  subtotal    Float       @default(0)
  currency    String      @default("BAM")
  claimedById Int?
  claimedBy   Waiter?     @relation("OrderClaimedBy", fields: [claimedById], references: [id])
  items       OrderItem[]

  @@index([status, createdAt])
  @@index([tableId, createdAt])
  @@index([claimedById, claimedAt])
}

model OrderItem {
  id      String  @id @default(cuid())
  orderId String
  itemId  String
  name    String
  price   Float
  qty     Int
  note    String?
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Call {
  id          String     @id @default(cuid())
  tableId     String
  type        String     @default("waiter")
  message     String?
  status      CallStatus @default(OPEN)
  createdAt   DateTime   @default(now())
  handledAt   DateTime?
  handledById Int?
  handledBy   Waiter?    @relation("CallHandledBy", fields: [handledById], references: [id])

  @@index([status, createdAt])
  @@index([tableId, createdAt])
}

model Table {
  id                   String                    @id
  name                 String?
  token                String                    @unique
  isActive             Boolean                   @default(true)
  createdAt            DateTime                  @default(now())
  verificationSessions RoomVerificationSession[]
}

model RoomVerificationSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  roomId    String
  room      Table    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  verifiedAt DateTime?
  expiresAt DateTime
  revokedAt DateTime?

  @@index([roomId, expiresAt])
}

model RoomServiceSettings {
  id              String   @id @default("default")
  enabled         Boolean  @default(false)
  timezone        String   @default("Europe/Sarajevo")
  weeklySchedule  Json?
  temporaryClosed Boolean  @default(false)
  closedMessage   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Waiter {
  name          String
  pin           String?   @unique
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  id            Int       @id @default(autoincrement())
  handledCalls  Call[]    @relation("CallHandledBy")
  claimedOrders Order[]   @relation("OrderClaimedBy")
}

enum OrderStatus {
  UNCLAIMED
  CLAIMED
  COMPLETED
}

enum CallStatus {
  OPEN
  HANDLED
}

enum MenuCategoryGroup {
  DRINKS
  FOOD
  DESSERTS
  KIDS
  OTHER
}
